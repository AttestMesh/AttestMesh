{
  "name": "attestmesh-deploy",
  "private": true,
  "type": "module",
  "description": "Durable deploy workflows (smithers) + standardized routines for AttestMesh.",
  "scripts": {
    "graph": "smithers-orchestrator graph workflows/deploy.tsx",
    "up": "smithers-orchestrator up workflows/deploy.tsx",
    "graph:postgres": "smithers-orchestrator graph workflows/postgres-node.tsx",
    "up:postgres": "smithers-orchestrator up workflows/postgres-node.tsx",
    "security:staged": "./precommit-security.sh",
    "security:test": "python3 -m unittest tests/test_precommit_security.py",
    "security:install": "./install-precommit-security.sh"
  },
  "devDependencies": {
    "smithers-orchestrator": "0.22.0",
    "zod": "^4.0.0"
  }
}
