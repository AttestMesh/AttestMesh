# Non-secret restart-persistent recovery configuration. Credentials are read
# from the existing 0600 files in ~/.attestmesh and deploy/logs. install.sh
# renders RECOVERY_ROOT to the absolute checkout that supplied this package.
RECOVERY_ROOT=
RECOVERY_STATE_DIR=
RECOVERY_SSH_TARGET=attestmesh-mesh-node
PG_REMOTE_HOSTS=10.18.147.86,10.18.251.71,10.18.172.186
PG_LOCAL_PORTS=55439,55440,55441
HINDSIGHT_LOCAL_PORT=18898
BUDGET_LOCAL_PORT=18899
FUGU_LOCAL_PORT=18419
PATRONI_LOCAL_PORTS=18081,18082,18083
APPROVED_TOTAL=5142
STAGE_CAP=5142
MAX_AGENT_ACTIVE=2
MAX_PROVIDER_IN_FLIGHT=6
CONSERVATIVE_REMAINING_COST_USD=0.00543
HARD_BUDGET_USD=30
GUARD_QUICK_SECONDS=2
GUARD_FULL_SECONDS=60
WATCHDOG_SECONDS=5
HEARTBEAT_MAX_AGE_SECONDS=60
CONTROLLER_SECONDS=5
CONTROLLER_INITIAL_BACKOFF_SECONDS=5
CONTROLLER_MAX_BACKOFF_SECONDS=300
CONTROLLER_STABLE_CHECKS=10
CONTROLLER_FULL_AUDITS=2
BUDGET_MAINTENANCE_HOLD_URL=http://127.0.0.1:18899/admin/maintenance-hold
# Empty means the installed recovery virtualenv and colocated verifier.
AGENT_RUNTIME_VERIFIER_COMMAND=
AGENT_RUNTIME_PROOF_FILE=
AGENT_RUNTIME_PROOF_MAX_AGE_SECONDS=120
AGENT_WORKER_HEARTBEAT_MAX_AGE_SECONDS=90
# Rollout must replace these with the reviewed/pinned values before starting
# the controller. The build ID must end in sha256:<reviewed outbox.py digest>.
EXPECTED_AGENT_IMAGE_DIGEST=
EXPECTED_AGENT_COMPOSE_HASH=
EXPECTED_AGENT_OUTBOX_BUILD_ID=
EXPECTED_RECOVERY_OUTBOX_BUILD_ID=
EXPECTED_HINDSIGHT_MODEL=openai/gpt-oss-120b
EXPECTED_HINDSIGHT_PHASE=backfill
EXPECTED_HINDSIGHT_LLM_CONCURRENCY=3
EXPECTED_PROVIDER_EFFECTIVE_LIMIT_USD=49.5
AGENT_PROGRESS_TIMEOUT_SECONDS=180
