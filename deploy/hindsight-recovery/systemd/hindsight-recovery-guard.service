[Unit]
Description=Hindsight recovery authoritative fail-closed guard
After=network-online.target hindsight-recovery-tunnel.service
Wants=network-online.target
Requires=hindsight-recovery-tunnel.service
StartLimitIntervalSec=0

[Service]
Type=simple
EnvironmentFile=%h/.config/hindsight-recovery/recovery.env
ExecStartPre=/usr/bin/test -x %h/.local/share/hindsight-recovery/current/venv/bin/python
ExecStart=%h/.local/share/hindsight-recovery/current/venv/bin/python %h/.local/share/hindsight-recovery/current/runtime/recovery.py guard
Restart=always
RestartSec=2s
CPUQuota=25%
MemoryMax=256M
TasksMax=64
NoNewPrivileges=yes

[Install]
WantedBy=default.target
