[Unit]
Description=Independent Hindsight recovery fail-closed watchdog
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
EnvironmentFile=%h/.config/hindsight-recovery/recovery.env
ExecStartPre=/usr/bin/test -x %h/.local/share/hindsight-recovery/current/venv/bin/python
ExecStart=%h/.local/share/hindsight-recovery/current/venv/bin/python %h/.local/share/hindsight-recovery/current/runtime/recovery.py watchdog
Restart=always
RestartSec=2s
CPUQuota=15%
MemoryMax=192M
TasksMax=48
NoNewPrivileges=yes

[Install]
WantedBy=default.target
