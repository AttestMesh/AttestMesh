# Copy to ~/.attestmesh/hindsight-canary.env (0600) and fill only from the
# dedicated Redpill virtual key. Never use ~/.attestmesh/redpill-key here.
CANARY_REDPILL_API_KEY=
CANARY_REDPILL_BASE_URL=https://api.redpill.ai/v1
CANARY_RUN_DIR=/home/ubuntu/.attestmesh/hindsight-canary/cost-gated-recovery-20260710
# Match the owner of CANARY_RUN_DIR; keep the directory 0700 and artifacts 0600.
CANARY_RUN_UID=1001
CANARY_RUN_GID=1001
CANARY_HARD_BUDGET_USD=2
# Leave room for one interrupted/ambiguous provider response while the
# provider-side virtual key remains the authoritative $2 hard stop.
CANARY_SAFETY_MARGIN_USD=0.05
CANARY_RPM_LIMIT=8
CANARY_TPM_LIMIT=500000

# Enter the current Redpill per-million-token prices from the key/provider
# console. The local ledger is a second stop; the virtual-key hard budget is the
# authoritative stop.
CANARY_20B_INPUT_USD_PER_M=
CANARY_20B_OUTPUT_USD_PER_M=
CANARY_120B_INPUT_USD_PER_M=
CANARY_120B_OUTPUT_USD_PER_M=

# Separate query-embedding key; this can use the already budgeted Qwen path.
CANARY_QWEN_API_KEY=
CANARY_QWEN_BASE_URL=https://api.redpill.ai/v1
CANARY_QWEN_MODEL=qwen/qwen3-embedding-8b

# Local temporary stack credentials. Generate both with `openssl rand -hex 24`.
CANARY_POSTGRES_PASSWORD=
CANARY_HINDSIGHT_TOKEN=
