{
  "name": "@attestmesh/mesh-state-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Stateless read-through on-chain mesh-state JSON API for AttestMesh clusters (public tier).",
  "engines": { "node": ">=20" },
  "bin": { "mesh-state-api": "src/server.ts" },
  "scripts": {
    "start": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "tsx": "^4.19.0",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  }
}
